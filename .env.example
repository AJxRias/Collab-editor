# Server configuration (all optional; defaults shown)
PORT=4000
# Without DATABASE_URL the server uses an in-memory store (data lost on restart).
DATABASE_URL=postgres://collab:collab@localhost:5432/collab
# Without REDIS_URL the server runs as a single instance (no cross-instance sync).
REDIS_URL=redis://localhost:6379
# INSTANCE_ID=server1
PERSIST_DEBOUNCE_MS=400
PERSIST_MAX_WAIT_MS=2000
COMPACT_EVERY=100
ROOM_IDLE_MS=10000
HEARTBEAT_MS=30000
MAX_MESSAGE_BYTES=1048576
WS_MESSAGES_PER_SEC=100
WS_MESSAGE_BURST=400
API_WRITES_PER_MIN=60
# Off by default when NODE_ENV=production; on in development.
# LIST_DOCS=false
# Set to 1 (or true) behind a load balancer so per-IP limits see the real client IP.
# TRUST_PROXY=1
# Serve the built client from this directory (the Docker image sets this).
# STATIC_DIR=client/dist
